<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
  BrujaBeer MochilaForm.fxml — Gestor de Documentos y PDFs de Producción

  Permite al cervecero subir, organizar por carpetas y consultar manuales,
  fichas técnicas, POEs y documentación operativa.

  CONTROLADOR: com.brujabeer.recetario.ui.controller.MochilaFormController
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brujabeer.recetario.ui.controller.MochilaFormController"
            style="-fx-font-family: 'Segoe UI', Arial, sans-serif;">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <!-- CABECERA: Toolbar con Logo e Información del Módulo -->
    <top>
        <VBox spacing="0" style="-fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <ToolBar style="-fx-padding: 8; -fx-background-color: #f8f9fa;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitHeight="40" preserveRatio="true">
                        <image>
                            <Image url="@/images/logo.png" />
                        </image>
                    </ImageView>
                    <VBox spacing="2">
                        <Label text="🎒 BrujaBeer — Mochila de Producción"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                        <Label text="v1.1 | Gestión de Manuales, Fichas Técnicas y Protocolos PDF"
                               style="-fx-font-size: 11px; -fx-text-fill: #666;" />
                    </VBox>
                </HBox>
            </ToolBar>
        </VBox>
    </top>

    <!-- LADO IZQUIERDO: Árbol de Carpetas -->
    <left>
        <VBox spacing="10" prefWidth="280"
              style="-fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0; -fx-padding: 12;">
            <Label text="📁 Carpetas de Mochila"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;" />

            <TreeView fx:id="treeCarpetas" VBox.vgrow="ALWAYS"
                      style="-fx-control-inner-background: #fafafa; -fx-padding: 4;" />

            <HBox spacing="8" alignment="CENTER">
                <Button text="➕ Nueva Carpeta" onAction="#crearNuevaCarpeta"
                        style="-fx-padding: 6 12 6 12; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <Button text="🗑 Eliminar" onAction="#eliminarCarpeta"
                        style="-fx-padding: 6 12 6 12; -fx-font-size: 11px;" />
            </HBox>
        </VBox>
    </left>

    <!-- CENTRO: Lista de Documentos -->
    <center>
        <VBox spacing="12" style="-fx-padding: 12;">

            <!-- Header de carpeta seleccionada y búsqueda -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: #fafafa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 10;">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblCarpetaActual" text="📁 Mochila Principal"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                    <Label fx:id="lblContadorArchivos" text="0 archivos"
                           style="-fx-font-size: 11px; -fx-text-fill: #888;" />
                </VBox>

                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="🔍 Buscar:" style="-fx-font-weight: bold; -fx-font-size: 11px;" />
                    <TextField fx:id="txtBuscar" promptText="Filtrar por nombre..." prefWidth="200"
                               style="-fx-padding: 6; -fx-font-size: 11;" />
                </HBox>
            </HBox>

            <!-- Tabla de documentos -->
            <TableView fx:id="tblDocumentos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre del Documento" prefWidth="380" />
                    <TableColumn fx:id="colTamano" text="Tamaño" prefWidth="110" />
                    <TableColumn fx:id="colFecha" text="Última Modificación" prefWidth="160" />
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
                        <Label text="📄 Sin documentos en esta carpeta"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #aaa;" />
                        <Label text="Hacé clic en '📥 Subir PDF' para agregar manuales o fichas técnicas."
                               style="-fx-font-size: 11px; -fx-text-fill: #bbb;" />
                    </VBox>
                </placeholder>
            </TableView>

        </VBox>
    </center>

    <!-- PIE: Barra de Acciones de Documentos -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0; -fx-padding: 12; -fx-background-color: #f8f9fa;">
            <Button text="🔄 Actualizar" onAction="#actualizarListaArchivos"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px;" />
            <Button text="🗑 Eliminar PDF" onAction="#eliminarDocumento"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px;" />
            <Button text="➡️ Mover PDF" onAction="#moverDocumento"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <Button text="👁 Abrir PDF" onAction="#abrirDocumento"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <Button text="📥 Subir PDF" onAction="#subirDocumento"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #c97e27; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />
        </HBox>
    </bottom>

</BorderPane>
