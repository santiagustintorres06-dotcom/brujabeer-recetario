<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<!--
  BrujaBeer RecipeForm.fxml — UI Rediseñada V1.2
  CONTROLADOR: com.brujabeer.recetario.ui.controller.RecipeFormController
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brujabeer.recetario.ui.controller.RecipeFormController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <!-- CABECERA: Menú + Toolbar -->
    <top>
        <VBox spacing="0">
            <MenuBar>
                <menus>
                    <Menu text="📋 Receta">
                        <items>
                            <MenuItem text="➕ Nueva" onAction="#limpiarFormulario" />
                            <MenuItem text="💾 Guardar" onAction="#guardarReceta" />
                            <SeparatorMenuItem />
                            <MenuItem text="❌ Salir" onAction="#cancelar" />
                        </items>
                    </Menu>
                    <Menu text="❓ Ayuda">
                        <items>
                            <MenuItem text="ℹ Acerca de BrujaBeer" onAction="#mostrarAcercaDe" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <ToolBar styleClass="bb-toolbar">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitHeight="40" preserveRatio="true">
                        <image>
                            <Image url="@/images/logo.png" />
                        </image>
                    </ImageView>
                    <VBox spacing="2">
                        <Label text="🍺 BrujaBeer Recetario" styleClass="bb-header-title" />
                        <Label text="v1.2 | Editor de Recetas Cerveceras" styleClass="bb-header-subtitle" />
                    </VBox>
                </HBox>
            </ToolBar>
        </VBox>
    </top>

    <!-- LADO IZQUIERDO: Lista de recetas guardadas -->
    <left>
        <VBox spacing="8" prefWidth="280" styleClass="bb-sidebar">
            <Label text="📚 Recetas Guardadas" styleClass="bb-section-title" />
            <ListView fx:id="lstRecetas" prefHeight="400" />
        </VBox>
    </left>

    <!-- CENTRO: Formulario principal -->
    <center>
        <VBox spacing="12">

            <!-- SECCIÓN 1: Datos generales -->
            <VBox spacing="8" styleClass="bb-card">
                <Label text="📝 Información de la Receta" styleClass="bb-section-title" />

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="15" />
                        <ColumnConstraints percentWidth="35" />
                        <ColumnConstraints percentWidth="15" />
                        <ColumnConstraints percentWidth="35" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints minHeight="60" />
                    </rowConstraints>

                    <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="bb-field-label" />
                    <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Ej: IPA Argentina" />

                    <Label text="Estilo:" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="bb-field-label" />
                    <ComboBox fx:id="cbEstilo" GridPane.rowIndex="0" GridPane.columnIndex="3"
                              editable="true" promptText="Seleccionar o escribir estilo..."
                              prefWidth="200" />

                    <Label text="Volumen (L):" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="bb-field-label" />
                    <TextField fx:id="txtVolumenLitros" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               promptText="20" />

                    <Label text="Equipo:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="bb-field-label" />
                    <ComboBox fx:id="cbEquipo" GridPane.rowIndex="2" GridPane.columnIndex="1"
                              prefWidth="200" promptText="Seleccionar equipo..." />

                    <Label text="Perfil Agua:" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="bb-field-label" />
                    <ComboBox fx:id="cbAguaPerfil" GridPane.rowIndex="2" GridPane.columnIndex="3"
                              prefWidth="200" promptText="Seleccionar agua..." />

                    <Label text="Descripción:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           styleClass="bb-field-label" style="-fx-alignment: TOP_LEFT;" />
                    <TextArea fx:id="txaDescripcion" prefRowCount="3" GridPane.rowIndex="3" GridPane.columnIndex="1"
                              GridPane.columnSpan="3" wrapText="true" />
                </GridPane>
            </VBox>

            <!-- SECCIÓN 2: Ingredientes (Pestañas) -->
            <TabPane>
                <tabs>
                    <!-- TAB 1: MALTAS -->
                    <Tab text="🌾 Maltas" closable="false">
                        <VBox spacing="10" styleClass="bb-card">
                            <Label text="Agregar Malta:" styleClass="bb-field-label" />
                            <HBox spacing="8">
                                <ComboBox fx:id="cbMaltaSeleccionada" prefWidth="250"
                                         promptText="Seleccionar malta..." />
                                <TextField fx:id="txtCantidadMalta" prefWidth="80"
                                          promptText="g" style="-fx-alignment: CENTER;" />
                                <Button fx:id="btnAgregarMalta" text="➕ Agregar" onAction="#agregarMalta"
                                       styleClass="bb-btn-primary" />
                                <Button fx:id="btnEliminarMalta" text="🗑 Eliminar" onAction="#eliminarMalta"
                                       styleClass="bb-btn-danger" />
                            </HBox>
                            <TableView fx:id="tblMaltas" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colMaltaNombre" text="Malta" prefWidth="240" />
                                    <TableColumn fx:id="colMaltaCantidad" text="Cantidad (g)" prefWidth="100" />
                                    <TableColumn fx:id="colMaltaPorcentaje" text="Grist (%)" prefWidth="80" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB 2: MACERADO -->
                    <Tab text="🔥 Macerado" closable="false">
                        <fx:include source="MaceradoTab.fxml" fx:id="maceradoTab"/>
                    </Tab>

                    <!-- TAB 3: LÚPULOS -->
                    <Tab text="🌿 Lúpulos" closable="false">
                        <VBox spacing="10" styleClass="bb-card">
                            <Label text="Agregar Lúpulo:" styleClass="bb-field-label" />
                            <HBox spacing="6">
                                <ComboBox fx:id="cbLupuloSeleccionado" prefWidth="200"
                                         promptText="Seleccionar lúpulo..." />
                                <TextField fx:id="txtCantidadLupulo" prefWidth="70"
                                          promptText="g" style="-fx-alignment: CENTER;" />
                                <TextField fx:id="txtTiempoLupulo" prefWidth="70"
                                          promptText="min" style="-fx-alignment: CENTER;" />
                                <ComboBox fx:id="cbUsoLupulo" prefWidth="120" />
                                <Button fx:id="btnAgregarLupulo" text="➕ Agregar" onAction="#agregarLupulo"
                                       styleClass="bb-btn-primary" />
                                <Button fx:id="btnEliminarLupulo" text="🗑 Eliminar" onAction="#eliminarLupulo"
                                       styleClass="bb-btn-danger" />
                            </HBox>
                            <TableView fx:id="tblLupulos" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colLupuloNombre" text="Lúpulo" prefWidth="200" />
                                    <TableColumn fx:id="colLupuloCantidad" text="Cantidad (g)" prefWidth="80" />
                                    <TableColumn fx:id="colLupuloTiempo" text="Tiempo (min)" prefWidth="80" />
                                    <TableColumn fx:id="colLupuloUso" text="Uso" prefWidth="110" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB 3.5: MISCELÁNEOS -->
                    <Tab text="🧪 Otros Ingredientes" closable="false">
                        <VBox spacing="10" styleClass="bb-card">
                            <Label text="Agregar Ingrediente:" styleClass="bb-field-label" />
                            <HBox spacing="6">
                                <TextField fx:id="txtNombreMiscelaneo" prefWidth="180"
                                          promptText="Ej: Irish Moss" />
                                <TextField fx:id="txtCantidadMiscelaneo" prefWidth="60"
                                          promptText="Cant" style="-fx-alignment: CENTER;" />
                                <TextField fx:id="txtUsoMiscelaneo" prefWidth="100"
                                          promptText="Hervor, etc." />
                                <TextField fx:id="txtTiempoMiscelaneo" prefWidth="60"
                                          promptText="min" style="-fx-alignment: CENTER;" />
                                <Button fx:id="btnAgregarMiscelaneo" text="➕ Agregar" onAction="#agregarMiscelaneo"
                                       styleClass="bb-btn-primary" />
                                <Button fx:id="btnEliminarMiscelaneo" text="🗑 Eliminar" onAction="#eliminarMiscelaneo"
                                       styleClass="bb-btn-danger" />
                            </HBox>
                            <TableView fx:id="tblMiscelaneos" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colMiscelaneoNombre" text="Ingrediente" prefWidth="180" />
                                    <TableColumn fx:id="colMiscelaneoCantidad" text="Cant" prefWidth="80" />
                                    <TableColumn fx:id="colMiscelaneoUso" text="Uso" prefWidth="100" />
                                    <TableColumn fx:id="colMiscelaneoTiempo" text="Tiempo" prefWidth="80" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB 4: LEVADURAS -->
                    <Tab text="🧬 Levaduras" closable="false">
                        <VBox spacing="10" styleClass="bb-card">
                            <Label text="Agregar Levadura:" styleClass="bb-field-label" />
                            <HBox spacing="8">
                                <ComboBox fx:id="cbLevaduraSeleccionada" prefWidth="220"
                                         promptText="Seleccionar levadura..." />
                                <ComboBox fx:id="cbFormatoLevadura" prefWidth="100"
                                         promptText="Formato" />
                                <TextField fx:id="txtCantidadLevadura" prefWidth="70"
                                          promptText="g" style="-fx-alignment: CENTER;" />
                                <Button fx:id="btnAgregarLevadura" text="➕ Agregar" onAction="#agregarLevadura"
                                       styleClass="bb-btn-primary" />
                                <Button fx:id="btnEliminarLevadura" text="🗑 Eliminar" onAction="#eliminarLevadura"
                                       styleClass="bb-btn-danger" />
                            </HBox>
                            <TableView fx:id="tblLevaduras" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colLevaduraNombre" text="Levadura" prefWidth="220" />
                                    <TableColumn fx:id="colLevaduraFormato" text="Formato" prefWidth="80" />
                                    <TableColumn fx:id="colLevaduraCantidad" text="Cantidad (g)" prefWidth="80" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- TAB 5: FERMENTACIÓN -->
                    <Tab text="🍾 Fermentación" closable="false">
                        <fx:include source="FermentacionPane.fxml" fx:id="fermentacionPane"/>
                    </Tab>

                    <!-- TAB 6: LOTES DE COCCIÓN -->
                    <Tab text="📜 Lotes de Cocción" closable="false">
                        <VBox spacing="10" styleClass="bb-card">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Cocciones elaboradas con esta receta:" styleClass="bb-field-label" />
                                <Label fx:id="lblTotalLotesReceta" text="0 lote(s)" styleClass="bb-info-text" />
                            </HBox>
                            <TableView fx:id="tblLotesDeReceta" prefHeight="180">
                                <columns>
                                    <TableColumn fx:id="colRecetaLoteNro" text="Lote #" prefWidth="70" />
                                    <TableColumn fx:id="colRecetaLoteFecha" text="Fecha" prefWidth="95" />
                                    <TableColumn fx:id="colRecetaLoteLitros" text="Litros Reales" prefWidth="95" />
                                    <TableColumn fx:id="colRecetaLoteOg" text="OG Real" prefWidth="75" />
                                    <TableColumn fx:id="colRecetaLoteAbv" text="ABV Real" prefWidth="75" />
                                    <TableColumn fx:id="colRecetaLoteEfic" text="Eficiencia" prefWidth="85" />
                                    <TableColumn fx:id="colRecetaLotePh" text="pH Macerado" prefWidth="95" />
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </tabs>
            </TabPane>

            <!-- SECCIÓN 3: Parámetros calculados -->
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="bb-card">
                <Label text="📊 Parámetros Calculados:" styleClass="bb-field-label" />
                <Separator />

                <VBox spacing="2" alignment="CENTER">
                    <Label text="OG" styleClass="bb-result-label" />
                    <Label fx:id="lblOgEstimada" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="FG" styleClass="bb-result-label" />
                    <Label fx:id="lblFgEstimada" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="IBU" styleClass="bb-result-label" />
                    <Label fx:id="lblIbuEstimado" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="ABV (%)" styleClass="bb-result-label" />
                    <Label fx:id="lblAbvEstimado" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="Color" styleClass="bb-result-label" />
                    <Label fx:id="lblColorEbc" text="—" styleClass="bb-result-value" />
                </VBox>
            </HBox>

        </VBox>
    </center>

    <!-- PIE: Botones de acción principales -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="bb-footer">
            <Button text="🔄 Limpiar" onAction="#limpiarFormulario" styleClass="bb-btn-secondary" />
            <Button fx:id="btnGuardarReceta" text="💾 Guardar Receta" onAction="#guardarReceta"
                   styleClass="bb-btn-primary" />
        </HBox>
    </bottom>

</BorderPane>
