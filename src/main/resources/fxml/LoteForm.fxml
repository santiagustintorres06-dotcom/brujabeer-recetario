<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<!--
  BrujaBeer LoteForm.fxml — Módulo de Lotes de Cocción (Batch)
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brujabeer.recetario.ui.controller.LoteFormController"
            style="-fx-font-family: 'Segoe UI', Arial, sans-serif;">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <!-- CABECERA: Toolbar con título del módulo -->
    <top>
        <VBox spacing="0" style="-fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <ToolBar style="-fx-padding: 8; -fx-background-color: #f8f9fa;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitHeight="40" preserveRatio="true">
                        <image>
                            <Image url="@/images/logo.png" />
                        </image>
                    </ImageView>
                    <VBox spacing="2">
                        <Label text="🍺 BrujaBeer — Módulo de Lotes de Cocción"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                        <Label text="v1.1 | Registro y Control de Día de Cocción"
                               style="-fx-font-size: 11px; -fx-text-fill: #666;" />
                    </VBox>
                </HBox>
            </ToolBar>
        </VBox>
    </top>

    <!-- CENTRO: Formulario de registro de cocción -->
    <center>
        <VBox spacing="14" style="-fx-padding: 12;">

            <!-- SECCIÓN 1: Selección de Receta -->
            <VBox spacing="8" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 12; -fx-background-color: #fafafa;">
                <Label text="📋 Receta a Cocinar"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Receta:" style="-fx-font-weight: bold;" />
                    <ComboBox fx:id="cbReceta" prefWidth="400"
                              promptText="Seleccioná la receta para esta cocción..."
                              style="-fx-padding: 4; -fx-font-size: 11;" />
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Estilo:" style="-fx-font-weight: bold;" />
                    <Label fx:id="lblEstiloReceta" text="—"
                           style="-fx-font-size: 12px; -fx-text-fill: #c97e27; -fx-font-weight: bold;" />
                </HBox>
            </VBox>

            <!-- SECCIÓN 2: Control de pH -->
            <VBox spacing="8" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 12; -fx-background-color: #fafafa;">
                <Label text="🧪 Control de pH"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <Label text="Rango óptimo de macerado: 5.2 – 5.6 | Lavado: por debajo de 6.0"
                       style="-fx-font-size: 10px; -fx-text-fill: #888; -fx-font-style: italic;" />

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                    </columnConstraints>

                    <Label text="pH Macerado:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtPhMacerado" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Ej: 5.35" style="-fx-padding: 6; -fx-font-size: 11;" />

                    <Label text="pH Lavado:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                           style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtPhLavado" GridPane.rowIndex="0" GridPane.columnIndex="3"
                               promptText="Ej: 5.80" style="-fx-padding: 6; -fx-font-size: 11;" />
                </GridPane>
            </VBox>

            <!-- SECCIÓN 3: Densidades y Volúmenes -->
            <VBox spacing="8" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 12; -fx-background-color: #fafafa;">
                <Label text="📊 Densidades y Volúmenes"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;" />

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                    </columnConstraints>

                    <!-- Fila 1: Pre-Hervor (solo densidad, litros removido) -->
                    <Label text="Densidad Pre-Hervor:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />
                    <TextField fx:id="txtDensidadPreHervor" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Ej: 1.042" style="-fx-padding: 6; -fx-font-size: 11;" />

                    <!-- Fila 2: Post-Hervor (OG real) -->
                    <Label text="OG Real (Post-Hervor):" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                    <TextField fx:id="txtDensidadInicialReal" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               promptText="Ej: 1.058"
                               style="-fx-padding: 6; -fx-font-size: 11; -fx-border-color: #c97e27; -fx-border-width: 2;" />

                    <Label text="Litros Finales:" GridPane.rowIndex="1" GridPane.columnIndex="2"
                           style="-fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                    <TextField fx:id="txtLitrosFinalesReal" GridPane.rowIndex="1" GridPane.columnIndex="3"
                               promptText="Ej: 20"
                               style="-fx-padding: 6; -fx-font-size: 11; -fx-border-color: #c97e27; -fx-border-width: 2;" />

                    <!-- Fila 3: Post-Fermentación (FG real) -->
                    <Label text="FG Real (Densidad Final):" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                    <TextField fx:id="txtDensidadFinalReal" GridPane.rowIndex="2" GridPane.columnIndex="1"
                               promptText="Ej: 1.012"
                               style="-fx-padding: 6; -fx-font-size: 11; -fx-border-color: #27ae60; -fx-border-width: 1.5;" />
                </GridPane>
            </VBox>

            <!-- SECCIÓN 4: Comentarios del cervecero -->
            <VBox spacing="8" style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 12; -fx-background-color: #fafafa;">
                <Label text="📝 Comentarios / Notas de Cocción"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <TextArea fx:id="txaComentarios" prefRowCount="3" wrapText="true"
                          promptText="Anotá contratiempos, ajustes hechos durante la cocción, etc."
                          style="-fx-padding: 6; -fx-font-size: 11;" />
            </VBox>

            <!-- SECCIÓN 5: Resultado de eficiencia (solo lectura, se muestra después de guardar) -->
            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-padding: 12; -fx-background-color: #fafafa;">
                <Label text="⚙️ Resultado Calculado:" style="-fx-font-weight: bold;" />
                <Separator orientation="VERTICAL" />

                <VBox spacing="2" alignment="CENTER">
                    <Label text="Eficiencia Real" style="-fx-font-size: 10px; -fx-text-fill: #999;" />
                    <Label fx:id="lblEficienciaReal" text="— %"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="OG Real" style="-fx-font-size: 10px; -fx-text-fill: #999;" />
                    <Label fx:id="lblOgReal" text="—"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="FG Real" style="-fx-font-size: 10px; -fx-text-fill: #999;" />
                    <Label fx:id="lblFgReal" text="—"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="ABV Real" style="-fx-font-size: 10px; -fx-text-fill: #999;" />
                    <Label fx:id="lblAbvReal" text="— %"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="Litros Finales" style="-fx-font-size: 10px; -fx-text-fill: #999;" />
                    <Label fx:id="lblLitrosFinales" text="—"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="pH Macerado" style="-fx-font-size: 10px; -fx-text-fill: #999;" />
                    <Label fx:id="lblPhStatus" text="—"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c97e27;" />
                </VBox>
            </HBox>

        </VBox>
    </center>

    <!-- LADO DERECHO: Historial de lotes registrados -->
    <right>
        <VBox spacing="8" prefWidth="280"
              style="-fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1; -fx-padding: 12;">
            <Label text="📜 Historial de Lotes"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333;" />
            <TableView fx:id="tblHistorialLotes" prefHeight="400">
                <columns>
                    <TableColumn fx:id="colNroLote" text="Nro Lote" prefWidth="70" />
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90" />
                    <TableColumn fx:id="colEficiencia" text="Efic. %" prefWidth="70" />
                </columns>
            </TableView>
        </VBox>
    </right>

    <!-- PIE: Botones de acción -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0; -fx-padding: 12; -fx-background-color: #f8f9fa;">
            <Button text="🔄 Limpiar" onAction="#limpiarFormulario"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px;" />
            <Button text="🧪 Registrar Cocción" onAction="#registrarCoccion"
                    style="-fx-padding: 8 16 8 16; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-color: #c97e27; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />
        </HBox>
    </bottom>

</BorderPane>
