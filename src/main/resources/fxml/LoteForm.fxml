<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<!--
  BrujaBeer LoteForm.fxml — Módulo de Lotes de Cocción V1.2
  CONTROLADOR: com.brujabeer.recetario.ui.controller.LoteFormController
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.brujabeer.recetario.ui.controller.LoteFormController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <!-- CABECERA -->
    <top>
        <VBox spacing="0">
            <ToolBar styleClass="bb-toolbar">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fitHeight="40" preserveRatio="true">
                        <image>
                            <Image url="@/images/logo.png" />
                        </image>
                    </ImageView>
                    <VBox spacing="2">
                        <Label text="🍺 BrujaBeer — Módulo de Lotes de Cocción" styleClass="bb-header-title" />
                        <Label text="v1.2 | Registro y Control de Día de Cocción" styleClass="bb-header-subtitle" />
                    </VBox>
                </HBox>
            </ToolBar>
        </VBox>
    </top>

    <!-- CENTRO: Formulario -->
    <center>
        <VBox spacing="14" style="-fx-padding: 12;">

            <!-- SECCIÓN 1: Selección de Receta -->
            <VBox spacing="8" styleClass="bb-card">
                <Label text="📋 Receta a Cocinar" styleClass="bb-section-title" />
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Receta:" styleClass="bb-field-label" />
                    <ComboBox fx:id="cbReceta" prefWidth="400"
                              promptText="Seleccioná la receta para esta cocción..." />
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Estilo:" styleClass="bb-field-label" />
                    <Label fx:id="lblEstiloReceta" text="—" styleClass="bb-result-value" />
                </HBox>
            </VBox>

            <!-- SECCIÓN 2: Control de pH -->
            <VBox spacing="8" styleClass="bb-card">
                <Label text="🧪 Control de pH" styleClass="bb-section-title" />
                <Label text="Rango óptimo de macerado: 5.2 – 5.6 | Lavado: por debajo de 6.0"
                       styleClass="bb-info-text" />

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                    </columnConstraints>

                    <Label text="pH Macerado:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="bb-field-label" />
                    <TextField fx:id="txtPhMacerado" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Ej: 5.35" />

                    <Label text="pH Lavado:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                           styleClass="bb-field-label" />
                    <TextField fx:id="txtPhLavado" GridPane.rowIndex="0" GridPane.columnIndex="3"
                               promptText="Ej: 5.80" />
                </GridPane>
            </VBox>

            <!-- SECCIÓN 3: Densidades y Volúmenes -->
            <VBox spacing="8" styleClass="bb-card">
                <Label text="📊 Densidades y Volúmenes" styleClass="bb-section-title" />

                <GridPane hgap="12" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="30" />
                    </columnConstraints>

                    <!-- Fila 1: Pre-Hervor -->
                    <Label text="Densidad Pre-Hervor:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           styleClass="bb-field-label" />
                    <TextField fx:id="txtDensidadPreHervor" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Ej: 1.042" />

                    <!-- Fila 2: Post-Hervor (OG real) -->
                    <Label text="OG Real (Post-Hervor):" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           styleClass="bb-field-label bb-field-important" />
                    <TextField fx:id="txtDensidadInicialReal" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               promptText="Ej: 1.058" styleClass="bb-field-important" />

                    <Label text="Litros Finales:" GridPane.rowIndex="1" GridPane.columnIndex="2"
                           styleClass="bb-field-label bb-field-important" />
                    <TextField fx:id="txtLitrosFinalesReal" GridPane.rowIndex="1" GridPane.columnIndex="3"
                               promptText="Ej: 20" styleClass="bb-field-important" />

                    <!-- Fila 3: Post-Fermentación (FG real) -->
                    <Label text="FG Real (Densidad Final):" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           styleClass="bb-field-label bb-field-success" />
                    <TextField fx:id="txtDensidadFinalReal" GridPane.rowIndex="2" GridPane.columnIndex="1"
                               promptText="Ej: 1.012" styleClass="bb-field-success" />
                </GridPane>
            </VBox>

            <!-- SECCIÓN 4: Comentarios -->
            <VBox spacing="8" styleClass="bb-card">
                <Label text="📝 Comentarios / Notas de Cocción" styleClass="bb-section-title" />
                <TextArea fx:id="txaComentarios" prefRowCount="3" wrapText="true"
                          promptText="Anotá contratiempos, ajustes hechos durante la cocción, etc." />
            </VBox>

            <!-- SECCIÓN 5: Resultado (solo lectura) -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="bb-card">
                <Label text="⚙️ Resultado Calculado:" styleClass="bb-field-label" />
                <Separator orientation="VERTICAL" />

                <VBox spacing="2" alignment="CENTER">
                    <Label text="Eficiencia Real" styleClass="bb-result-label" />
                    <Label fx:id="lblEficienciaReal" text="— %" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="OG Real" styleClass="bb-result-label" />
                    <Label fx:id="lblOgReal" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="FG Real" styleClass="bb-result-label" />
                    <Label fx:id="lblFgReal" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="ABV Real" styleClass="bb-result-label" />
                    <Label fx:id="lblAbvReal" text="— %" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="Litros Finales" styleClass="bb-result-label" />
                    <Label fx:id="lblLitrosFinales" text="—" styleClass="bb-result-value" />
                </VBox>

                <VBox spacing="2" alignment="CENTER">
                    <Label text="pH Macerado" styleClass="bb-result-label" />
                    <Label fx:id="lblPhStatus" text="—" styleClass="bb-result-value" />
                </VBox>
            </HBox>

        </VBox>
    </center>

    <!-- LADO DERECHO: Historial -->
    <right>
        <VBox spacing="8" prefWidth="280" styleClass="bb-sidebar">
            <Label text="📜 Historial de Lotes" styleClass="bb-section-title" />
            <Label text="Doble-clic para ver los datos de un lote" styleClass="bb-info-text" />
            <TableView fx:id="tblHistorialLotes" prefHeight="400">
                <columns>
                    <TableColumn fx:id="colNroLote" text="Nro Lote" prefWidth="70" />
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90" />
                    <TableColumn fx:id="colEficiencia" text="Efic. %" prefWidth="70" />
                </columns>
            </TableView>
        </VBox>
    </right>

    <!-- PIE: Botones de acción -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="bb-footer">
            <Button text="🔄 Limpiar" onAction="#limpiarFormulario" styleClass="bb-btn-secondary" />
            <Button text="🧪 Registrar Cocción" onAction="#registrarCoccion" styleClass="bb-btn-primary" />
        </HBox>
    </bottom>

</BorderPane>
