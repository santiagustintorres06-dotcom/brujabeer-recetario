<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ╔══════════════════════════════════════════════════════════════════╗ -->
    <!-- ║  PARENT: Spring Boot BOM (Bill of Materials)                    ║ -->
    <!-- ║  Nos da versiones coherentes para TODAS las dependencias de SB  ║ -->
    <!-- ╚══════════════════════════════════════════════════════════════════╝ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.brujabeer</groupId>
    <artifactId>recetario</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>BrujaBeer - Módulo Recetario</name>
    <description>Creador de Recetas de Cerveza Artesanal - BrujaBeer</description>

    <!-- ╔══════════════════════════════════════════════════════════════════╗ -->
    <!-- ║  PROPIEDADES GLOBALES                                           ║ -->
    <!-- ╚══════════════════════════════════════════════════════════════════╝ -->
    <properties>
        <java.version>21</java.version>
        <javafx.version>21.0.4</javafx.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- ╔══════════════════════════════════════════════════════════════════╗ -->
    <!-- ║  DEPENDENCIAS                                                   ║ -->
    <!-- ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependencies>

        <!-- ── Spring Core (SIN servidor web embebido) ─────────────────────
             spring-boot-starter-web NO va aquí. Somos heavy-client desktop.
             Este starter nos da: IoC/DI, @Component, @Service, @Autowired    -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- ── JPA + Hibernate 6 ────────────────────────────────────────────
             Trae: Hibernate Core, Spring Data JPA, Transacciones             -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ── H2 Database (EMBEBIDA — PORTABLE) ────────────────────────────
             Base de datos embebida que guarda datos en archivo local.
             No necesita servidor externo: ideal para app desktop.          -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── MySQL Connector/J (OPCIONAL) ──────────────────────────────────
             Driver JDBC para MySQL 8.x. Descomentar si se quiere usar MySQL
             en lugar de H2. Requiere servidor MySQL corriendo.              -->
        <!--
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        -->

        <!-- ── JavaFX: Controls ─────────────────────────────────────────────
             TextField, TableView, ComboBox, Button, Alert, Label, Tab, etc.  -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ── JavaFX: FXML ─────────────────────────────────────────────────
             FXMLLoader: conecta los archivos .fxml con los @Controller        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ── Lombok ───────────────────────────────────────────────────────
             Genera getters, setters, constructores en tiempo de compilación.
             @Getter @Setter @NoArgsConstructor @AllArgsConstructor @Builder   -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.40</version>
            <optional>true</optional>
        </dependency>

        <!-- ── Validation (Bean Validation / Hibernate Validator) ───────────
             @NotNull, @Size, @Min, @Max en las entidades y DTOs              -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Test ─────────────────────────────────────────────────────────
             JUnit 5, Mockito, Spring Test                                     -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ╔══════════════════════════════════════════════════════════════════╗ -->
    <!-- ║  BUILD PLUGINS                                                  ║ -->
    <!-- ╚══════════════════════════════════════════════════════════════════╝ -->
    <build>
        <plugins>

            <!-- ── Maven Compiler ───────────────────────────────────────────
                 Java 21 + Lombok annotation processor                         -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.40</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- ── Spring Boot Maven Plugin ─────────────────────────────────
                 Empaqueta el fat-JAR. Excluye Lombok del artefacto final.     -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- ── JavaFX Maven Plugin ──────────────────────────────────────
                 Para DESARROLLO: mvn javafx:run
                 Maneja el module-path de JavaFX automáticamente en Java 17+.
                 Las opciones (add-opens) resuelven el acceso reflectivo
                 que Hibernate/Spring necesitan en el Java Module System. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>
                                com.brujabeer.recetario.BrujaRecetarioApp
                            </mainClass>
                            <options>
                                <!-- Requeridos por Hibernate 6 + Java 21 module system -->
                                <option>--add-opens=java.base/java.lang=ALL-UNNAMED</option>
                                <option>--add-opens=java.base/java.util=ALL-UNNAMED</option>
                                <option>--add-opens=java.base/java.math=ALL-UNNAMED</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
